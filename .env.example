# ============================================================================
# Miljövariabler för Driftpuls (Admin & Publik Driftportal)
# ============================================================================
# OBS: Om .env saknas när du kör ./deploy.sh skapas den automatiskt med ett
# slumpat lösenord för första admin-användaren.

# Första inloggningskontot (används bara vid första uppstart om data/users.json saknas)
ADMIN_USER=admin
ADMIN_PASS=BytTillEttStarktLosenordMinst12Tecken

# Valfri publik adress (används i SMS-länkar och sociala medier-texter).
# Lämna tom för att automatiskt använda serverns lokala IP-adress på port 3001.
PUBLIC_URL=

# Portar på värdmaskinen
ADMIN_PORT=3000
PORTAL_PORT=3001
